# Sweet and Sour's own Stripe secret. A restricted key (rk_) is preferred.
# Leave this blank until that account exists. Checkout then explains the
# connection and does not charge a card. Do not use another business's key.
STRIPE_SECRET_KEY=

# Optional. Inquiry forms open the visitor's email app until both of these are set.
# RESEND_API_KEY=
# INQUIRY_FROM_EMAIL="Sweet and Sour <orders@yourdomain.com>"

# Password for /manage. Leave unset to keep the editor closed.
MANAGE_PASSWORD=
